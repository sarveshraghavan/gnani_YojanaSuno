# Copy to backend/.env. Never commit backend/.env or put real keys in this example.
# Do not paste secrets in chat, source, tests, or this file. Run the gitleaks pre-commit hook.
USE_MOCK_VOICE=true
USE_MOCK_LLM=true
GNANI_API_KEY=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
# Optional override; blank selects a documented locale-specific v2.5 voice. Verify
# any override for each language; the suggested "sia" voice is not listed currently.
GNANI_TTS_VOICE=
PRISMA_MODEL=prisma-v3.0
TIMBRE_MODEL=timbre-v2.5

# Optional self-hosted Evon vLLM/SGLang OpenAI-compatible endpoint.
EVON_BASE_URL=
EVON_API_KEY=
EVON_MODEL=model
