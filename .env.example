# Gnani Prisma and Timbre API key ID. Leave blank for local demo mode.
GNANI_API_KEY=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_VOICE=
PRISMA_MODEL=prisma-v3.0
TIMBRE_MODEL=timbre-v2.5
USE_MOCK_VOICE=true
USE_MOCK_LLM=true

# Optional Evon OpenAI-compatible inference endpoint. Evon does not determine eligibility.
EVON_BASE_URL=
EVON_API_KEY=
EVON_MODEL=model

